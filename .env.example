# Copiez ce fichier en .env pour personnaliser la configuration.

# Port et adresse d'écoute du serveur
PORT=3000
HOST=0.0.0.0

# Dossier contenant un sous-dossier par anime
MEDIA_DIR=media

# Bibliothèque persistée + caches (métadonnées, images)
DATA_DIR=data

# Re-scan automatique, en minutes (0 = désactivé)
SCAN_INTERVAL=10

# Re-scan immédiat quand un fichier arrive dans le dossier média
WATCH_MEDIA=true

# Rafraîchissement des métadonnées (jours) — 1 jour pour les séries en cours
META_TTL_DAYS=7

# Délai entre deux appels à l'API Jikan (limite publique : 3/s, 60/min)
JIKAN_DELAY_MS=1000
# JIKAN_BASE_URL=https://api.jikan.moe/v4

# Domaines d'images autorisés par le proxy /img
IMAGE_HOSTS=cdn.myanimelist.net,myanimelist.net,img.youtube.com,i.ytimg.com
